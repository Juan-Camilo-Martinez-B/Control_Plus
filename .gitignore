# ============================================
# .gitignore Principal - ControlPlus
# ============================================

# ============================================
# Backend - Java/Spring Boot
# ============================================
# Maven
Backend/target/
Backend/.mvn/
Backend/mvnw
Backend/mvnw.cmd
!Backend/.mvn/wrapper/maven-wrapper.jar

# Archivos compilados
Backend/*.jar
Backend/*.war
Backend/*.class

# Logs
Backend/*.log

# ⚠️ CRÍTICO: Contiene contraseñas de MongoDB y Gmail
Backend/src/main/resources/application.properties
Backend/src/main/resources/application-*.properties

# Spring Boot
Backend/.springBeans
Backend/.sts4-cache
Backend/.apt_generated
Backend/.factorypath

# ============================================
# Frontend - Next.js
# ============================================
# Dependencies
frontend/node_modules/
frontend/.pnp
frontend/.pnp.*

# Next.js
frontend/.next/
frontend/out/
frontend/build/
frontend/dist/
frontend/next-env.d.ts

# ⚠️ Variables de entorno (pueden contener URLs de producción)
frontend/.env
frontend/.env*.local
frontend/.env.local
frontend/.env.development.local
frontend/.env.production.local

# Testing
frontend/coverage/
frontend/.nyc_output/

# Deployment
frontend/.vercel

# Lock files (solo uno debe estar en el proyecto)
frontend/package-lock.json
frontend/yarn.lock
frontend/pnpm-lock.yaml

# TypeScript
frontend/*.tsbuildinfo

# ============================================
# IDEs y Editores
# ============================================
.vscode/
.idea/
*.iml
*.iws
*.ipr
*.swp
*.swo
*~
.DS_Store
.project
.classpath
.settings/
.factorypath
.springBeans
.sts4-cache

# ============================================
# Logs
# ============================================
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# ============================================
# Sistema Operativo
# ============================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ============================================
# Temporales y Compilados
# ============================================
*.class
*.dll
*.exe
*.o
*.so
*.tmp
*.bak

# ============================================
# Git
# ============================================
.git/
*.orig

# ============================================
# Archivos de Configuración Sensibles
# ============================================
# IMPORTANTE: application.properties contiene contraseñas
# Solo se debe versionar application.properties.example
Backend/src/main/resources/application.properties

# Variables de entorno
.env
.env.local
.env.production
.env.development

# ============================================
# Archivos de Despliegue (OPCIONAL)
# ============================================
# Descomenta si no quieres versionar guías de despliegue
# DESPLIEGUE.md

# ============================================
# Subcarpetas .git (evitar submódulos accidentales)
# ============================================
Backend/.git/
frontend/.git/

